NUBEFACT_ENABLED=false
# Permite emitir certificados sin enviar comprobantes solo fuera de producción.
# Debe permanecer en false en producción.
NUBEFACT_SIMULATION_ENABLED=false
NUBEFACT_ENVIRONMENT=PRODUCCION
# Doble confirmación de seguridad. Cambiar a true únicamente durante un pase
# a producción autorizado y después de completar todas las validaciones.
NUBEFACT_PRODUCTION_CONFIRMED=false
# Valores permitidos: PENDIENTE, NO_APLICA, APLICA.
# APLICA requiere implementar y validar previamente los datos tributarios SPOT.
NUBEFACT_DETRACCION_DECISION=PENDIENTE
NUBEFACT_ALLOW_GLOBAL_FALLBACK=false
NUBEFACT_ALLOW_LEGACY_CREDENTIAL_KEYS=false
NUBEFACT_TIMEOUT_MS=10000
NUBEFACT_RETRY_LOCK_MS=120000
NUBEFACT_MAX_ATTEMPTS=5
NUBEFACT_ENVIAR_SUNAT=false
NUBEFACT_ENVIAR_CLIENTE=false
# Reconciliación asíncrona. Mantener deshabilitada hasta superar las pruebas
# PRODUCCIÓN. El intervalo está expresado en milisegundos (900000 = 15 minutos).
NUBEFACT_RECONCILIATION_ENABLED=false
NUBEFACT_NOTAS_RECONCILIATION_ENABLED=false
NUBEFACT_RECONCILIATION_RETRY_MS=900000
# Motor tributario aislado. Mantener false hasta ejecutar la migración de
# preparación, cargar series verificadas y aprobar formalmente el corte.
NUBEFACT_CORRELATIVOS_V2_ENABLED=false

# Credenciales por empresa/RUC emisor. La clave se obtiene de
# fg_empresa_facturador.credencial_clave. Nunca versionar tokens reales.
# Las variables incluyen el ambiente para impedir que una credencial de otro
# entorno o empresa termine siendo usada en PRODUCCIÓN. No versionar el token.
NUBEFACT_FAREGAS_PRODUCCION_API_URL=
NUBEFACT_FAREGAS_PRODUCCION_TOKEN=
NUBEFACT_FAREGAS_PRODUCCION_RUC=20521536463

# Compatibilidad temporal solamente. Mantener desactivada en producción.
# NUBEFACT_API_URL=
# NUBEFACT_TOKEN=

# Tarifas Faregas. Se puede definir una tarifa general o sobrescribirla por tipo.
FAREGAS_TARIFA_DEFAULT=150.00
# FAREGAS_TARIFA_GNV_ANUAL=150.00
# FAREGAS_TARIFA_GLP_ANUAL=150.00
# FAREGAS_TARIFA_CONFORMIDAD=150.00
